# Yojana Setu - Environment Configuration
# Copy this file to .env and fill in your values

APP_ENV=development

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

# API Keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Search Configuration
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional Database
DATABASE_URL=

# Timeouts (seconds)
SEARCH_TIMEOUT=30
LLM_TIMEOUT=60
FETCH_TIMEOUT=15

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
